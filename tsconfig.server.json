{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist/backend",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "prisma/seed.ts", "vitest.server.config.ts"],
  "exclude": ["server/**/*.test.ts", "server/tests/**", "node_modules", "dist"]
}
