{
  "name": "celeste-cartomancia",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:server": "tsx watch server/server.ts",
    "start:server": "node dist/backend/server/server.js",
    "build": "pnpm build:frontend && pnpm build:server",
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "check": "pnpm check:frontend && pnpm check:server",
    "check:frontend": "tsc --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:frontend": "eslint client vite.config.ts vitest.config.ts",
    "lint:server": "eslint server prisma prisma.config.ts vitest.server.config.ts",
    "test": "pnpm test:frontend && pnpm test:server",
    "test:frontend": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:server:unit": "vitest run --config vitest.server.config.ts server/tests/unit",
    "test:server:integration": "vitest run --config vitest.server.config.ts server/tests/integration",
    "coverage:server": "vitest run --coverage --config vitest.server.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "lucide-react": "^0.453.0",
    "luxon": "^3.7.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.64.0",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <27"
  }
}
